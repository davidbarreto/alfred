{
 "info": {
  "name": "Alfred - Places lived API",
  "_postman_id": "alfred-location-residences-v1",
  "description": "Places lived (/location/residences): the birth row, an open row, the clash rules (second birth or open row, overlap: 409; bad periods: 422), edit, travel's lived status and born flag, the city delete guard, the follow-Home fix, cleanup. Synthetic cities in a per-run country; assumes no rows exist yet (CI's fresh database).",
  "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
 },
 "auth": {
  "type": "bearer",
  "bearer": [
   {
    "key": "token",
    "value": "{{api_token}}",
    "type": "string"
   }
  ]
 },
 "item": [
  {
   "name": "01 - Find Home And Its City",
   "event": [
    {
     "listen": "test",
     "script": {
      "type": "text/javascript",
      "exec": [
       "pm.test('Status is 200', () => pm.response.to.have.status(200));",
       "pm.environment.set('lived_run', String(Date.now()));",
       "const homes = pm.response.json();",
       "pm.test('One home, with a city', () => { pm.expect(homes).to.have.lengthOf(1); pm.expect(homes[0].city).to.have.property('id'); });",
       "pm.environment.set('lived_home_city_id', homes[0].city.id);"
      ]
     }
    }
   ],
   "request": {
    "method": "GET",
    "header": [],
    "url": {
     "raw": "{{base_url}}/location/places?kind=home",
     "host": [
      "{{base_url}}"
     ],
     "path": [
      "location",
      "places"
     ],
     "query": [
      {
       "key": "kind",
       "value": "home"
      }
     ]
    }
   }
  },
  {
   "name": "02 - Create The Birth City",
   "event": [
    {
     "listen": "test",
     "script": {
      "type": "text/javascript",
      "exec": [
       "pm.test('Status is 201', () => pm.response.to.have.status(201));",
       "pm.environment.set('lived_birth_city_id', pm.response.json().id);",
       "pm.environment.set('lived_country_id', pm.response.json().country.id);"
      ]
     }
    }
   ],
   "request": {
    "method": "POST",
    "header": [
     {
      "key": "Content-Type",
      "value": "application/json"
     }
    ],
    "url": {
     "raw": "{{base_url}}/location/cities",
     "host": [
      "{{base_url}}"
     ],
     "path": [
      "location",
      "cities"
     ]
    },
    "body": {
     "mode": "raw",
     "raw": "{\n  \"name\": \"Postman birth city {{lived_run}}\",\n  \"country\": \"Postman lived land {{lived_run}}\"\n}"
    }
   }
  },
