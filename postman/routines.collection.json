{
  "info": {
    "name": "Alfred - Routines API",
    "_postman_id": "alfred-routines-v1",
    "description": "Run in order: Health Check \u2192 event-based routine (create, steps, validation, attach, detach) \u2192 scheduled routine (rule validation, window steps) \u2192 cleanup",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{api_token}}",
        "type": "string"
      }
    ]
  },
  "item": [
    {
      "name": "01 - Health Check",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Status is 200', () => pm.response.to.have.status(200));"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{base_url}}/health",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "health"
          ]
        },
        "auth": {
          "type": "noauth"
        }
      }
    },
    {
      "name": "02 - Create Event-Based Routine",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Status is 201', () => pm.response.to.have.status(201));",
              "pm.test('Routine saved', () => {",
              "    const json = pm.response.json();",
              "    pm.expect(json.name).to.eql('Postman dinner routine');",
              "    pm.expect(json.recurrence_rule).to.be.null;",
              "    pm.expect(json.steps).to.eql([]);",
              "    pm.environment.set('routine_id', json.id);",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{base_url}}/organizer/routines",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "organizer",
            "routines"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Postman dinner routine\",\n  \"description\": \"Runs around an event\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      }
    },
    {
      "name": "03 - Add Relative Step",
