{
  "info": {
    "name": "Alfred - Travel API",
    "description": "Travel module: trips (with legs, stays, tags), places and the travel tag vocabulary. Run in order. Everything created is synthetic and deleted at the end.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{api_token}}",
        "type": "string"
      }
    ]
  },
  "item": [
    {
      "name": "01 - Create Trip",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "exec": [
              "pm.environment.set('travel_ts', Date.now());"
            ],
            "type": "text/javascript"
          }
        },
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Status is 201', () => pm.response.to.have.status(201));",
              "const j = pm.response.json();",
              "pm.test('Tags attached', () => pm.expect(j.tags).to.eql(['postman-' + pm.environment.get('travel_ts')]));",
              "pm.test('Status is derived', () => pm.expect(['upcoming','ongoing','past']).to.include(j.status));",
              "pm.environment.set('travel_trip_id', j.id);"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{base_url}}/travel/trips",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "travel",
            "trips"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Postman trip {{travel_ts}}\",\n  \"start_date\": \"2031-12-17\",\n  \"end_date\": \"2031-12-24\",\n  \"travelers\": \"Test travelers\",\n  \"default_tag_names\": \"Travel, Hotel\",\n  \"tags\": [\n    \"postman-{{travel_ts}}\"\n  ]\n}"
        }
      }
    },
    {
      "name": "02 - Create Trip With Reversed Dates",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Status is 422', () => pm.response.to.have.status(422));"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{base_url}}/travel/trips",
          "host": [
            "{{base_url}}"
