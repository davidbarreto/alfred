            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "PUT",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{base_url}}/organizer/interview-prep-questions/{{prep_question_id}}/stories/{{story_id}}",
          "host": [
            "{{base_url}}"
          ],
          "path": [
