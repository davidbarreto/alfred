          "raw": "{\n  \"name\": \"{{metric_series}}\",\n  \"kind\": \"duration\"\n}"
        }
      }
    },
    {
      "name": "03 - Quick Start",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Status is 200', () => pm.response.to.have.status(200));",
              "const j = pm.response.json();",
              "pm.test('Entry is open', () => pm.expect(j.entry.status).to.eql('open'));",
              "pm.test('Message names the series', () => pm.expect(j.message).to.include(pm.environment.get('metric_series')));",
              "pm.test('Tag attached', () => pm.expect(j.entry.tags).to.eql([pm.environment.get('metric_tag')]));",
              "pm.test('Nothing discarded', () => pm.expect(j.discarded_entry_id).to.eql(null));",
              "pm.environment.set('metric_first_entry_id', j.entry.id);"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{base_url}}/metrics/quick/start",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "metrics",
            "quick",
            "start"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"series\": \"{{metric_series}}\",\n  \"tags\": [\n    \"{{metric_tag}}\"\n  ],\n  \"lat\": 41.15,\n  \"lon\": -8.63,\n  \"accuracy_m\": 20\n}"
        }
      }
    },
