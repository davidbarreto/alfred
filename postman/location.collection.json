     "listen": "test",
     "script": {
      "type": "text/javascript",
      "exec": [
       "pm.test('Status is 200', () => pm.response.to.have.status(200));",
       "const j = pm.response.json();",
       "pm.test('Countries carry a code and a city count', () => {",
       "    pm.expect(j.countries.length).to.be.above(0);",
       "    j.countries.forEach(c => { pm.expect(c).to.have.property('code'); pm.expect(c.city_count).to.be.a('number'); });",
       "});",
       "pm.test('Only cities and places with coordinates', () => {",
       "    j.cities.concat(j.places).forEach(r => { pm.expect(r.latitude).to.be.a('number'); pm.expect(r.longitude).to.be.a('number'); });",
       "    pm.expect(j.cities_without_coordinates).to.be.a('number');",
       "    pm.expect(j.places_without_coordinates).to.be.a('number');",
       "});",
       "pm.test('The new pin and the other city are on it', () => {",
       "    pm.expect(j.places.map(p => p.id)).to.include(pm.environment.get('map_place_id'));",
       "    pm.expect(j.cities.map(c => c.id)).to.include(pm.environment.get('place_other_city_id'));",
       "});",
       "pm.test('At most one home city', () => pm.expect(j.cities.filter(c => c.home).length).to.be.at.most(1));"
      ]
