              "const mine = pm.response.json().find(t => t.name === 'postman-place-' + pm.environment.get('travel_ts'));",
              "pm.test('Place tag counted', () => pm.expect(mine.place_count).to.eql(0));",
              "pm.environment.set('travel_place_tag_id', mine.id);"
