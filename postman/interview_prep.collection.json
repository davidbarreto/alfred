            "interview-prep-questions",
            "{{prep_question_id}}",
            "stories",
            "{{story_id}}"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"fit_score\": 4\n}"
        }
      }
    },
