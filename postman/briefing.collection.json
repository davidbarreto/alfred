{
  "info": {
    "name": "Alfred - Briefing API",
    "_postman_id": "alfred-briefing-v1",
    "description": "Morning briefing and evening digest endpoints. Run: Health Check → Morning Briefing JSON → Morning Briefing Formatted → Formatted (Reused) → Formatted (Force Regenerate) → Evening Digest JSON → Evening Digest Formatted (Not Generated Yet) → Formatted (Force Regenerate) → Formatted (Reused) → Briefing History → Briefing History (Filtered by Type)",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{api_token}}",
        "type": "string"
      }
    ]
  },
  "item": [
    {
      "name": "01 - Health Check",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Status is 200', () => pm.response.to.have.status(200));",
              "pm.test('Status is ok', () => {",
              "    pm.expect(pm.response.json().status).to.eql('ok');",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "auth": {
          "type": "noauth"
        },
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{base_url}}/health",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "health"
          ]
        }
      }
    },
    {
      "name": "01a - Create A Location With Coordinates For The Weather",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Status is 201', () => pm.response.to.have.status(201));",
              "const json = pm.response.json();",
              "pm.environment.set('briefing_weather_location_id', json.id);",
              "pm.environment.set('briefing_weather_location_name', json.name);",
              "pm.test('Coordinates are stored', () => pm.expect([json.latitude, json.longitude]).to.eql([41.1579, -8.6291]));"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{base_url}}/organizer/locations",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "organizer",
            "locations"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Postman weather place {{$timestamp}}\",\n  \"kind\": \"other\",\n  \"coordinates\": \"41.1579, -8.6291\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      }
    },
    {
      "name": "01b - Weather Settings - Pick That Location",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Status is 200', () => pm.response.to.have.status(200));",
              "const json = pm.response.json();",
              "pm.test('The location is in use and listed as a choice', () => {",
              "    pm.expect(json.location_id).to.eql(pm.environment.get('briefing_weather_location_id'));",
              "    pm.expect(json.city_id).to.eql(null);",
              "    pm.expect(json.place_label).to.eql(pm.environment.get('briefing_weather_location_name'));",
              "    pm.expect(json.choices.locations.map(c => c.id)).to.include(pm.environment.get('briefing_weather_location_id'));",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ],
