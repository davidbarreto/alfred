    }
   ],
   "request": {
    "method": "PATCH",
    "header": [
     {
      "key": "Content-Type",
      "value": "application/json"
     }
    ],
    "url": {
     "raw": "{{base_url}}/location/places/{{place_id}}",
     "host": [
      "{{base_url}}"
     ],
     "path": [
      "location",
      "places",
      "{{place_id}}"
     ]
    },
    "body": {
     "mode": "raw",
     "raw": "{\n  \"city_id\": null\n}"
    }
   }
  },
  {
   "name": "14 - Rename And Archive",
   "event": [
    {
     "listen": "test",
     "script": {
      "type": "text/javascript",
      "exec": [
       "pm.test('Status is 200', () => pm.response.to.have.status(200));",
       "pm.test('Saved', () => { const json = pm.response.json(); pm.expect(json.name).to.eql('Postman renamed cafe ' + pm.environment.get('place_run')); pm.expect(json.active).to.be.false; });"
      ]
     }
    }
   ],
   "request": {
    "method": "PATCH",
    "header": [
     {
      "key": "Content-Type",
      "value": "application/json"
     }
    ],
    "url": {
     "raw": "{{base_url}}/location/places/{{place_id}}",
     "host": [
      "{{base_url}}"
     ],
     "path": [
      "location",
      "places",
      "{{place_id}}"
     ]
    },
    "body": {
     "mode": "raw",
     "raw": "{\n  \"name\": \"Postman renamed cafe {{place_run}}\",\n  \"active\": false\n}"
    }
   }
  },
  {
   "name": "15 - Archived Places Are Filtered Out",
   "event": [
    {
     "listen": "test",
     "script": {
      "type": "text/javascript",
      "exec": [
       "pm.test('Status is 200', () => pm.response.to.have.status(200));",
       "pm.test('Not listed', () => pm.expect(pm.response.json().map((p) => p.id)).to.not.include(Number(pm.environment.get('place_id'))));"
      ]
     }
    }
   ],
   "request": {
    "method": "GET",
    "header": [],
    "url": {
     "raw": "{{base_url}}/location/places?active=true&city_id={{place_home_city_id}}",
     "host": [
      "{{base_url}}"
     ],
     "path": [
      "location",
      "places"
     ],
     "query": [
      {
       "key": "active",
       "value": "true"
      },
      {
       "key": "city_id",
       "value": "{{place_home_city_id}}"
      }
     ]
    }
   }
  },
