       "    pm.expect(json.opening_hours).to.eql({ mon: [['09:00', '17:00']], hol: [['09:00', '13:00']] });",
       "    pm.expect(json.opening_hours_text).to.eql('mon 09:00-17:00; holidays 09:00-13:00');",
       "    pm.expect(json.notes).to.eql('Cash only');",
       "    pm.expect(json.categories.map((c) => c.name)).to.eql(['grocery']);",
       "});"
      ],
