              "    const json = pm.response.json();",
              "    pm.expect(json.anchor).to.eql('start');",
              "    pm.expect(json.offset_minutes).to.eql(-120);",
              "    pm.expect(json.position).to.eql(0);",
              "    pm.environment.set('routine_step_id', json.id);",
              "});"
            ],
            "type": "text/javascript"
          }
        }
