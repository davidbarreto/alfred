{
  "info": {
    "name": "Alfred - CS Coach API",
    "_postman_id": "alfred-cs-v1",
    "description": "Run in order: Health Check \u2192 Create Platform \u2192 List/Get/Update Platform \u2192 Create Problems (with tags) \u2192 List/Get/Filter Problems \u2192 Create Submissions (manual import) \u2192 List/Get Submissions \u2192 Stats Summary \u2192 Live Recommendation \u2192 Generate Study Plan \u2192 Get Active Plan \u2192 Complete Plan Item \u2192 Trigger Platform Sync",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{api_token}}",
        "type": "string"
      }
    ]
  },
  "item": [
    {
      "name": "ci-safe",
      "description": "No LLM calls, no external network calls (Codeforces/LeetCode). Safe to run against the null-integration CI container.",
      "item": [
        {
          "name": "01 - Health Check",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status is 200', () => pm.response.to.have.status(200));",
                  "pm.test('Status is ok', () => {",
                  "    pm.expect(pm.response.json().status).to.eql('ok');",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/health",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "health"
              ]
            }
          }
        },
        {
          "name": "02 - Create Platform (Codeforces)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status is 201', () => pm.response.to.have.status(201));",
                  "pm.test('Response has id and saves it', () => {",
                  "    const json = pm.response.json();",
                  "    pm.expect(json).to.have.property('id');",
                  "    pm.expect(json.code).to.eql('codeforces');",
                  "    pm.expect(json.handle).to.eql('tourist');",
                  "    pm.expect(json.sync_enabled).to.be.true;",
                  "    pm.environment.set('cs_platform_id', json.id);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"code\": \"codeforces\",\n  \"handle\": \"tourist\",\n  \"sync_enabled\": true\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{base_url}}/cs/platforms",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "cs",
                "platforms"
              ]
            }
          }
        },
        {
          "name": "03 - List Platforms",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
