       "const ids = rows.map(r => r.id);",
       "pm.test('Open row before the birth row', () => pm.expect(ids.indexOf(Number(pm.environment.get('lived_second_id')))).to.be.below(ids.indexOf(Number(pm.environment.get('lived_birth_id')))));"
      ]
