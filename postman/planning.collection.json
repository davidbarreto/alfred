        "body": {
          "mode": "raw",
          "raw": "{\n  \"days\": [\n    {\n      \"date\": \"2031-03-03\",\n      \"notes\": \"Postman note 2031-03-03\",\n      \"items\": [\n        {\n          \"start\": \"2031-03-03T10:00:00+00:00\",\n          \"end\": \"2031-03-03T11:00:00+00:00\",\n          \"kind\": \"other\",\n          \"title\": \"Postman block A v2\",\n          \"note\": \"synthetic\"\n        }\n      ]\n    }\n  ]\n}",
          "options": {
