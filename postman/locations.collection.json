{
 "info": {
  "name": "Alfred - Locations API",
  "_postman_id": "alfred-locations-v1",
  "description": "Run in order: create a shop with text hours and a seeded category → name clash, bad hours and unknown category → get, list filters → update hours as an object → archive → categories → command lookup by name → home uniqueness → cleanup. Names carry a per-run suffix, so reruns against the same database pass; the run leaves nothing behind.",
  "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
 },
 "auth": {
  "type": "bearer",
  "bearer": [
   {
    "key": "token",
    "value": "{{api_token}}",
    "type": "string"
   }
  ]
 },
 "item": [
  {
   "name": "01 - Health Check",
   "event": [
    {
     "listen": "test",
     "script": {
      "exec": [
       "pm.test('Status is 200', () => pm.response.to.have.status(200));"
      ],
      "type": "text/javascript"
     }
    }
   ],
   "request": {
    "method": "GET",
    "header": [],
    "url": {
     "raw": "{{base_url}}/health",
     "host": [
      "{{base_url}}"
     ],
     "path": [
      "health"
     ]
    },
    "auth": {
     "type": "noauth"
    }
   }
  },
  {
   "name": "02 - Look Up Seeded Grocery Category",
   "event": [
    {
     "listen": "prerequest",
     "script": {
      "exec": [
       "// Names are unique case-insensitively: a per-run suffix keeps reruns against the same database green.",
       "pm.environment.set('location_run', String(Date.now()));",
       "pm.environment.set('location_home_id', '0');"
      ],
      "type": "text/javascript"
     }
    },
    {
     "listen": "test",
     "script": {
      "exec": [
       "pm.test('Status is 200', () => pm.response.to.have.status(200));",
       "pm.test('grocery category exists', () => {",
       "    const grocery = pm.response.json().find((c) => c.name === 'grocery');",
       "    pm.expect(grocery, 'grocery category').to.exist;",
       "    pm.environment.set('location_category_id', grocery.id);",
       "});"
      ],
      "type": "text/javascript"
     }
    }
   ],
   "request": {
    "method": "GET",
    "header": [],
    "url": {
     "raw": "{{base_url}}/organizer/shopping-categories",
     "host": [
      "{{base_url}}"
     ],
     "path": [
      "organizer",
      "shopping-categories"
     ]
    }
   }
  },
  {
   "name": "03 - Create Location (text hours, sells grocery)",
   "event": [
    {
     "listen": "test",
     "script": {
      "exec": [
       "pm.test('Status is 201', () => pm.response.to.have.status(201));",
       "pm.test('Hours parsed, categories linked, today computed', () => {",
       "    const json = pm.response.json();",
       "    pm.expect(json.name).to.eql('Postman market ' + pm.environment.get('location_run'));",
       "    pm.expect(json.kind).to.eql('supermarket');",
       "    pm.expect(json.opening_hours.mon).to.eql([['08:00', '20:00']]);",
       "    pm.expect(json.opening_hours.sat).to.eql([['09:00', '13:00'], ['15:00', '19:00']]);",
       "    pm.expect(json.opening_hours.sun).to.eql([]);",
       "    pm.expect(json.opening_hours.hol).to.eql([]);",
       "    pm.expect(json.opening_hours_text).to.eql('mon-fri 08:00-20:00; sat 09:00-13:00, 15:00-19:00; sun closed; holidays closed');",
       "    pm.expect(json.categories.map((c) => c.name)).to.eql(['grocery']);",
       "    pm.expect(json.active).to.be.true;",
       "    pm.expect(json.today).to.have.property('date');",
       "    pm.expect(json.today).to.have.property('open_now');",
       "    pm.environment.set('location_id', json.id);",
       "});"
      ],
      "type": "text/javascript"
     }
    }
   ],
   "request": {
    "method": "POST",
    "header": [
     {
      "key": "Content-Type",
      "value": "application/json"
     }
    ],
    "url": {
     "raw": "{{base_url}}/organizer/locations",
     "host": [
      "{{base_url}}"
     ],
     "path": [
      "organizer",
      "locations"
     ]
    },
    "body": {
     "mode": "raw",
     "raw": "{\n  \"name\": \"  Postman   market {{location_run}} \",\n  \"kind\": \" Supermarket \",\n  \"address\": \"Rua Exemplo 1\",\n  \"opening_hours\": \"mon-fri 8-20; sat 9-13, 15:00-19:00; sun closed; holidays closed\",\n  \"category_ids\": [\n    {{location_category_id}}\n  ]\n}",
     "options": {
      "raw": {
       "language": "json"
      }
     }
    }
   }
  },
