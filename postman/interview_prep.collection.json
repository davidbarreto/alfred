{
  "info": {
    "name": "Alfred - Interview Prep API",
    "description": "Behavioral interview prep: STAR stories (shared tags, search, AI strength assessment), prep questions (with the same shared tags) with story links scored by fit (1-5), and candidate questions to ask interviewers. Run in order; the last requests clean up everything the run created.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{api_token}}",
        "type": "string"
      }
    ]
  },
  "item": [
    {
      "name": "01 - Create Story",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Status is 201', () => pm.response.to.have.status(201));",
              "const json = pm.response.json();",
              "pm.test('Tags normalized', () => pm.expect(json.tags.map(t => t.name)).to.eql(['postman-leadership', 'postman-ops']));",
              "pm.test('Timestamps present', () => pm.expect(json.created_at).to.be.a('string'));",
              "pm.environment.set('story_id', json.id);"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{base_url}}/organizer/interview-stories",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "organizer",
            "interview-stories"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"situation\": \"Postman test: service kept timing out\",\n  \"task\": \"Stabilise before peak\",\n  \"action\": \"Added caching and a circuit breaker\",\n  \"result\": \"p99 latency halved\",\n  \"strength\": 4,\n  \"tags\": [\n    \"postman-leadership\",\n    \" postman-ops \",\n    \"postman-leadership\"\n  ]\n}"
        }
      }
    },
    {
      "name": "02 - Create Story (invalid strength)",
      "event": [
