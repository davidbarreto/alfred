    {
      "name": "12 - Get Saved Week (only active versions)",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Status is 200', () => pm.response.to.have.status(200));",
              "pm.test('One active plan per date, other dates unchanged', () => {",
              "    const json = pm.response.json();",
              "    pm.expect(json).to.have.length(3);",
              "    pm.expect(json.map(p => p.plan_date)).to.eql(['2031-03-03', '2031-03-04', '2031-03-05']);",
              "    json.forEach(p => pm.expect(p.archived_at).to.be.null);",
              "    pm.expect(json[0].items[0].title).to.eql('Postman block A v2');",
              "    pm.expect(json[1].items[0].title).to.eql('Postman block B');",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{base_url}}/planning/saved?from=2031-03-03&to=2031-03-09",
