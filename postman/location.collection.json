{
 "info": {
  "name": "Alfred - Location places API",
  "_postman_id": "alfred-location-places-v1",
  "description": "What a place is (/location/places): create with the Home place's city as the default, names unique per city, list filters, the travel and everyday views of a base place, archive, delete. Cleans up the city and country it creates. Names carry a per-run suffix.",
  "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
 },
 "auth": {
  "type": "bearer",
  "bearer": [
   {
    "key": "token",
    "value": "{{api_token}}",
    "type": "string"
   }
  ]
 },
 "item": [
  {
   "name": "01 - Find Home And Its City",
   "event": [
    {
     "listen": "prerequest",
     "script": {
      "type": "text/javascript",
      "exec": [
       "pm.environment.set('place_run', String(Date.now()));"
      ]
     }
    },
    {
     "listen": "test",
     "script": {
      "type": "text/javascript",
      "exec": [
       "pm.test('Status is 200', () => pm.response.to.have.status(200));",
       "pm.test('One home, with a city', () => {",
       "    const homes = pm.response.json();",
       "    pm.expect(homes).to.have.lengthOf(1);",
       "    pm.expect(homes[0].city).to.have.property('id');",
       "    pm.environment.set('place_home_city_id', homes[0].city.id);",
       "});"
      ]
     }
    }
   ],
   "request": {
    "method": "GET",
    "header": [],
    "url": {
     "raw": "{{base_url}}/location/places?kind=home",
     "host": [
      "{{base_url}}"
     ],
     "path": [
      "location",
      "places"
     ],
     "query": [
      {
       "key": "kind",
       "value": "home"
      }
     ]
    }
   }
  },
  {
   "name": "02 - Create Another City",
   "event": [
    {
     "listen": "test",
     "script": {
      "type": "text/javascript",
      "exec": [
       "pm.test('Status is 201', () => pm.response.to.have.status(201));",
       "pm.environment.set('place_other_city_id', pm.response.json().id);",
       "pm.environment.set('place_other_country_id', pm.response.json().country.id);"
      ]
     }
    }
   ],
   "request": {
    "method": "POST",
    "header": [
     {
      "key": "Content-Type",
      "value": "application/json"
     }
    ],
    "url": {
     "raw": "{{base_url}}/location/cities",
     "host": [
      "{{base_url}}"
     ],
     "path": [
      "location",
      "cities"
     ]
    },
    "body": {
     "mode": "raw",
     "raw": "{\n  \"name\": \"Postman place city {{place_run}}\",\n  \"country\": \"Postman place land {{place_run}}\"\n}"
    }
   }
  },
  {
   "name": "03 - Create Place Without A City (Home's city)",
   "event": [
    {
     "listen": "test",
     "script": {
      "type": "text/javascript",
      "exec": [
       "pm.test('Status is 201', () => pm.response.to.have.status(201));",
       "const json = pm.response.json();",
       "pm.environment.set('place_id', json.id);",
       "pm.test('In the home city, defaults filled', () => {",
       "    pm.expect(json.city.id).to.eql(Number(pm.environment.get('place_home_city_id')));",
       "    pm.expect(json.kind).to.eql('cafe');",
       "    pm.expect(json.active).to.be.true;",
       "    pm.expect([json.latitude, json.longitude]).to.eql([41.1579, -8.6291]);",
       "    pm.expect(json.opening_hours_text).to.eql('daily 08:00-19:00');",
       "    pm.expect(json.today).to.have.property('hours');",
       "    pm.expect(json.maps_link).to.include('https://');",
       "});"
      ]
     }
    }
   ],
   "request": {
    "method": "POST",
    "header": [
     {
      "key": "Content-Type",
      "value": "application/json"
     }
    ],
    "url": {
     "raw": "{{base_url}}/location/places",
     "host": [
      "{{base_url}}"
     ],
     "path": [
      "location",
      "places"
     ]
    },
    "body": {
     "mode": "raw",
     "raw": "{\n  \"name\": \"Postman cafe {{place_run}}\",\n  \"kind\": \" Cafe \",\n  \"coordinates\": \"41.1579, -8.6291\",\n  \"opening_hours\": \"daily 8-19\"\n}"
    }
   }
  },
