    {
      "name": "03 - List Trips (upcoming)",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Status is 200', () => pm.response.to.have.status(200));",
              "const ids = pm.response.json().map(t => t.id);",
              "pm.test('Created trip is listed', () => pm.expect(ids).to.include(Number(pm.environment.get('travel_trip_id'))));"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{base_url}}/travel/trips?status=upcoming&tag=postman-{{travel_ts}}",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "travel",
            "trips"
          ],
          "query": [
            {
              "key": "status",
              "value": "upcoming"
            },
            {
              "key": "tag",
              "value": "postman-{{travel_ts}}"
            }
          ]
        }
      }
    },
