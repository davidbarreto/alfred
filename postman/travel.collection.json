          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Status is 200', () => pm.response.to.have.status(200));",
              "const j = pm.response.json();",
              "pm.test('Has the leg and stay', () => { pm.expect(j.legs.length).to.eql(1); pm.expect(j.stays.length).to.eql(1); });",
              "pm.test('Timeline is chronological', () => pm.expect(j.timeline.map(i => i.kind)).to.eql(['leave_home','leg','check_in','check_out']));",
              "pm.test('Leave-home time is set', () => pm.expect(j.leave_home_at).to.be.a('string'));",
              "pm.test('Long wait warning', () => pm.expect(j.warnings.map(w => w.kind)).to.include('long_wait_before_check_in'));"
            ],
            "type": "text/javascript"
