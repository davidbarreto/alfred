     }
    ],
    "url": {
     "raw": "{{base_url}}/location/places",
     "host": [
      "{{base_url}}"
     ],
     "path": [
      "location",
      "places"
     ]
    },
    "body": {
     "mode": "raw",
     "raw": "{\n  \"name\": \"Postman nowhere {{place_run}}\",\n  \"city_id\": 999999999\n}"
    }
   }
  },
  {
   "name": "07 - Unknown Kind (422)",
   "event": [
    {
     "listen": "test",
     "script": {
      "type": "text/javascript",
      "exec": [
       "pm.test('Status is 422', () => pm.response.to.have.status(422));"
      ]
     }
    }
   ],
   "request": {
    "method": "POST",
    "header": [
     {
      "key": "Content-Type",
      "value": "application/json"
     }
    ],
    "url": {
     "raw": "{{base_url}}/location/places",
     "host": [
      "{{base_url}}"
     ],
     "path": [
      "location",
      "places"
     ]
    },
    "body": {
     "mode": "raw",
     "raw": "{\n  \"name\": \"Postman castle {{place_run}}\",\n  \"kind\": \"castle\"\n}"
    }
   }
  },
  {
   "name": "08 - List By City",
   "event": [
    {
     "listen": "test",
     "script": {
      "type": "text/javascript",
      "exec": [
       "pm.test('Status is 200', () => pm.response.to.have.status(200));",
       "pm.test('Only the other city\\'s place', () => pm.expect(pm.response.json().map((p) => p.id)).to.eql([Number(pm.environment.get('place_elsewhere_id'))]));"
      ]
     }
    }
   ],
   "request": {
    "method": "GET",
    "header": [],
    "url": {
     "raw": "{{base_url}}/location/places?city_id={{place_other_city_id}}",
     "host": [
      "{{base_url}}"
     ],
     "path": [
      "location",
      "places"
     ],
     "query": [
      {
       "key": "city_id",
       "value": "{{place_other_city_id}}"
      }
     ]
    }
   }
  },
  {
   "name": "09 - List By Country And Search",
   "event": [
    {
     "listen": "test",
     "script": {
      "type": "text/javascript",
      "exec": [
       "pm.test('Status is 200', () => pm.response.to.have.status(200));",
       "pm.test('Found by name within the country', () => pm.expect(pm.response.json().map((p) => p.id)).to.include(Number(pm.environment.get('place_elsewhere_id'))));"
      ]
     }
    }
   ],
   "request": {
    "method": "GET",
    "header": [],
    "url": {
     "raw": "{{base_url}}/location/places?country_id={{place_other_country_id}}&q=postman cafe",
     "host": [
      "{{base_url}}"
     ],
     "path": [
      "location",
      "places"
     ],
     "query": [
      {
       "key": "country_id",
       "value": "{{place_other_country_id}}"
      },
      {
       "key": "q",
       "value": "postman cafe"
      }
     ]
    }
   }
  },
  {
   "name": "10 - Travel View Of The Place",
   "event": [
    {
     "listen": "test",
     "script": {
      "type": "text/javascript",
      "exec": [
       "pm.test('Status is 200', () => pm.response.to.have.status(200));",
       "pm.test('No grade, tags or history yet', () => {",
       "    const json = pm.response.json();",
       "    pm.expect([json.grade, json.grade_count, json.tags, json.visits, json.stays]).to.eql([null, 0, [], [], []]);",
       "});"
      ]
     }
    }
   ],
   "request": {
    "method": "GET",
    "header": [],
    "url": {
     "raw": "{{base_url}}/travel/places/{{place_elsewhere_id}}",
     "host": [
      "{{base_url}}"
     ],
     "path": [
      "travel",
      "places",
      "{{place_elsewhere_id}}"
     ]
    }
   }
  },
  {
   "name": "11 - Everyday View Of The Place",
   "event": [
    {
     "listen": "test",
     "script": {
      "type": "text/javascript",
      "exec": [
       "pm.test('Status is 200', () => pm.response.to.have.status(200));",
       "pm.test('Not an everyday place', () => pm.expect(pm.response.json().everyday).to.be.false);"
      ]
     }
    }
   ],
   "request": {
    "method": "GET",
    "header": [],
    "url": {
     "raw": "{{base_url}}/organizer/places/{{place_id}}",
     "host": [
      "{{base_url}}"
     ],
     "path": [
      "organizer",
      "places",
      "{{place_id}}"
     ]
    }
   }
  },
  {
   "name": "12 - Move It To The Other City (409, the name is taken there)",
   "event": [
    {
     "listen": "test",
     "script": {
      "type": "text/javascript",
      "exec": [
       "pm.test('Status is 409', () => pm.response.to.have.status(409));"
      ]
     }
    }
   ],
   "request": {
    "method": "PATCH",
    "header": [
     {
      "key": "Content-Type",
      "value": "application/json"
     }
    ],
    "url": {
     "raw": "{{base_url}}/location/places/{{place_id}}",
     "host": [
      "{{base_url}}"
     ],
     "path": [
      "location",
      "places",
      "{{place_id}}"
     ]
    },
    "body": {
     "mode": "raw",
     "raw": "{\n  \"city_id\": {{place_other_city_id}}\n}"
    }
   }
  },
  {
   "name": "13 - Clearing The City Is Refused (422)",
   "event": [
    {
     "listen": "test",
     "script": {
      "type": "text/javascript",
      "exec": [
       "pm.test('Status is 422', () => pm.response.to.have.status(422));"
