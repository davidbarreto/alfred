{
  "info": {
    "name": "Alfred - Metrics API",
    "description": "Personal measurement log: duration (start/stop), value and count series, entries, and tags. Run in order. Entries and series are never hard-deleted (all FKs are RESTRICT), so the run discards its entries and archives its uniquely named series (postman-*-<timestamp>) at the end.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{api_token}}",
        "type": "string"
      }
    ]
  },
  "item": [
    {
      "name": "01 - Create Duration Series",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "exec": [
              "const ts = Date.now();",
              "pm.environment.set('metric_series', 'postman-commute-' + ts);",
              "pm.environment.set('metric_value_series', 'postman-sleep-' + ts);",
              "pm.environment.set('metric_tag', 'postman-tag-' + ts);"
            ],
            "type": "text/javascript"
          }
        },
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Status is 201', () => pm.response.to.have.status(201));",
              "const j = pm.response.json();",
              "pm.test('Name is a slug', () => pm.expect(j.name).to.eql(pm.environment.get('metric_series')));",
              "pm.test('Kind is duration', () => pm.expect(j.kind).to.eql('duration'));"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{base_url}}/metrics/series",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "metrics",
            "series"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"{{metric_series}}\",\n  \"kind\": \"duration\",\n  \"unit\": \"min\"\n}"
        }
      }
    },
    {
      "name": "02 - Create Duplicate Series",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Status is 409', () => pm.response.to.have.status(409));"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{base_url}}/metrics/series",
          "host": [
            "{{base_url}}"
