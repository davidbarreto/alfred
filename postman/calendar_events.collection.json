{
  "info": {
    "name": "Alfred - Calendar Events API",
    "_postman_id": "alfred-calendar-events-v1",
    "description": "Run in order: Health Check \u2192 Create \u2192 List \u2192 Get \u2192 Update \u2192 Filter by Date Range \u2192 Filter by Tags \u2192 Get 404 \u2192 Create with Timezone \u2192 Delete with Timezone \u2192 Delete \u2192 Create Recurring Weekly Event \u2192 List Events (Recurring Series Expands Into Occurrences) \u2192 Delete Recurring Event",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{api_token}}",
        "type": "string"
      }
    ]
  },
  "item": [
    {
      "name": "01 - Health Check",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Status is 200', () => pm.response.to.have.status(200));",
              "pm.test('Status is ok', () => {",
              "    pm.expect(pm.response.json().status).to.eql('ok');",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "auth": {
          "type": "noauth"
        },
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{base_url}}/health",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "health"
          ]
        }
      }
    },
    {
      "name": "02 - Create Event",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Status is 201', () => pm.response.to.have.status(201));",
              "pm.test('Response has id and saves it', () => {",
              "    const json = pm.response.json();",
              "    pm.expect(json).to.have.property('id');",
              "    pm.expect(json.title).to.eql('Q4 Planning Meeting');",
              "    pm.expect(json.location).to.eql('Conference Room A');",
              "    pm.expect(json.all_day).to.eql(false);",
              "    pm.expect(json.tags).to.include('work');",
              "    pm.environment.set('event_id', json.id);",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"title\": \"Q4 Planning Meeting\",\n  \"description\": \"Quarterly planning session for the product team.\",\n  \"location\": \"Conference Room A\",\n  \"start_datetime\": \"2026-07-01T10:00:00\",\n  \"end_datetime\": \"2026-07-01T11:30:00\",\n  \"all_day\": false,\n  \"tags\": [\n    \"work\",\n    \"planning\"\n  ]\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
