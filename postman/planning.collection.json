      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{base_url}}/planning/saved?from=2031-03-03&to=2031-03-03&version={{saved_plan_first_version}}",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "planning",
            "saved"
          ],
          "query": [
            {
              "key": "from",
              "value": "2031-03-03"
            },
            {
              "key": "to",
              "value": "2031-03-03"
            },
            {
              "key": "version",
              "value": "{{saved_plan_first_version}}"
            }
          ]
        }
      }
    },
    {
      "name": "14 - Saved Plan History",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Status is 200', () => pm.response.to.have.status(200));",
              "pm.test('Newest first, both versions kept', () => {",
              "    const json = pm.response.json();",
              "    pm.expect(json.length).to.be.at.least(2);",
              "    pm.expect(json[0].version).to.be.above(json[1].version);",
              "    pm.expect(json[0].archived_at).to.be.null;",
              "    pm.expect(json[1].archived_at).to.be.a('string');",
              "    pm.environment.set('saved_plan_active_id', json[0].id);",
              "    pm.environment.set('saved_plan_old_id', json[1].id);",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": {
