  {
   "name": "04 - Born There, Since Birth",
   "event": [
    {
     "listen": "test",
     "script": {
      "type": "text/javascript",
      "exec": [
       "pm.test('Status is 201', () => pm.response.to.have.status(201));",
       "const row = pm.response.json();",
       "pm.environment.set('lived_birth_id', row.id);",
       "pm.test('A birth row with no start, closed', () => { pm.expect(row.born).to.eql(true); pm.expect(row.from_date).to.eql(null); pm.expect(row.to_date).to.eql('1990-03-01'); pm.expect(row.current).to.eql(false); pm.expect(row.city.country).to.have.property('name'); });"
      ]
     }
    }
   ],
