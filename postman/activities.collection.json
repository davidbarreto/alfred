{
  "info": {
    "name": "Alfred - Activities API",
    "_postman_id": "alfred-activities-v1",
    "description": "Run in order: Health Check \u2192 create/update (validation) \u2192 log (now, past, future, invalid) \u2192 history, stats, day-plan suggestion \u2192 archive/unarchive. Activities with logs cannot be deleted, so the run leaves one archived-then-restored activity behind.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{api_token}}",
        "type": "string"
      }
    ]
  },
  "item": [
    {
      "name": "01 - Health Check",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Status is 200', () => pm.response.to.have.status(200));"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{base_url}}/health",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "health"
          ]
        },
        "auth": {
          "type": "noauth"
        }
      }
    },
    {
      "name": "02 - Create Activity",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Status is 201', () => pm.response.to.have.status(201));",
              "pm.test('Activity saved', () => {",
              "    const json = pm.response.json();",
              "    pm.expect(json.title).to.eql('Postman gym');",
              "    pm.expect(json.target_per_week).to.eql(3);",
              "    pm.expect(json.tags).to.have.members(['health', 'sport']);",
              "    pm.expect(json.archived_at).to.be.null;",
              "    pm.expect(json.last_done_at).to.be.null;",
              "    pm.environment.set('activity_id', json.id);",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{base_url}}/organizer/activities",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "organizer",
            "activities"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"title\": \"Postman gym\",\n  \"min_minutes\": 60,\n  \"max_minutes\": 90,\n  \"context\": \"out\",\n  \"target_per_week\": 3,\n  \"tags\": [\n    \"health\",\n    \"sport\"\n  ]\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      }
    },
