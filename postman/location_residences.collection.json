       "pm.test('Listed as lived, born, until 1990', () => { pm.expect(row.status).to.eql('lived'); pm.expect(row.born).to.eql(true); pm.expect(row.lived_until).to.eql('1990-03-01'); pm.expect(row.living).to.eql(false); pm.expect(row).to.have.property('trips_since'); });"
