    {
      "name": "13 - List Events (Recurring Series Expands Into Occurrences)",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Status is 200', () => pm.response.to.have.status(200));",
              "pm.test('Series expands into every weekly occurrence in the queried month, not just the creation month', () => {",
              "    const json = pm.response.json();",
              "    const occurrences = json.filter(e => e.id === pm.environment.get('recurring_event_id'));",
              "    pm.expect(occurrences.length).to.eql(4);",
              "    occurrences.forEach(e => pm.expect(e.start_datetime.startsWith('2026-09')).to.be.true);",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ],
